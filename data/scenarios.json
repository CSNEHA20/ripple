{
  "scenarios": [
    {
      "id": "inc_hist_01",
      "family": "historical",
      "title": "Historical Incident: Payment Service Bad Deployment Latency",
      "description": "Deployment v1.4.2 introduced unoptimized synchronous cryptographic verification in paymentservice, causing p95 latency to exceed 2500ms.",
      "alert": {
        "service": "paymentservice",
        "text": "p95 latency > 2500ms on paymentservice credit card authorization",
        "severity": "CRITICAL"
      },
      "ground_truth": {
        "root_cause_service": "paymentservice",
        "root_cause_type": "bad_deploy",
        "correct_runbook": "rb_rollback",
        "memory_should_help": true
      },
      "metrics": [
        {"service": "paymentservice", "status": "failing", "latency_p95_ms": 2650.0, "error_rate": 0.09},
        {"service": "checkoutservice", "status": "degraded", "latency_p95_ms": 1350.0, "error_rate": 0.05},
        {"service": "frontend", "status": "degraded", "latency_p95_ms": 820.0, "error_rate": 0.02},
        {"service": "cartservice", "status": "normal", "latency_p95_ms": 25.0, "error_rate": 0.0},
        {"service": "currencyservice", "status": "normal", "latency_p95_ms": 18.0, "error_rate": 0.0}
      ],
      "deployments": [
        {"service": "paymentservice", "hours_before_alert": 1.5, "version": "v1.4.2"}
      ],
      "architecture_changes": [],
      "interventions": {
        "rb_rollback": "resolved",
        "rb_restart": "failed",
        "rb_scale_up": "partial"
      }
    },
