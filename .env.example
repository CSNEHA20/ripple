# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider (optional in replay/mock mode, required for live LLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NEMOTRON_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# GitHub API (for M2 data ingestion, optional if cached)
GITHUB_TOKEN=
