# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider (optional in replay/mock mode, required for live LLM)
